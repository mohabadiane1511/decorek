# Copier en .env et remplacer toutes les valeurs avant tout démarrage.
# Le .env n'est jamais versionné : en production, générer des secrets longs et aléatoires
# (par exemple : openssl rand -base64 32).

# --- Base de données ---
POSTGRES_USER=decorek
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=decorek

# La chaîne de connexion du backend vit dans backend/.env, pas ici : ce fichier décrit
# comment Docker Compose démarre les services, pas comment on s'y connecte.

# --- Cache / sessions ---
REDIS_PASSWORD=changez-moi
# Au-delà de cette taille, les clés les moins utilisées sont évincées (allkeys-lru).
REDIS_MAXMEMORY=256mb

# --- Stockage des images ---
# MinIO refuse de démarrer si le mot de passe fait moins de 8 caractères.
MINIO_ROOT_USER=decorek
MINIO_ROOT_PASSWORD=changez-moi
MINIO_BUCKET=decorek-media

# --- Ports du poste de développement (docker-compose.dev.yml uniquement) ---
# Décalés pour ne pas entrer en conflit avec un PostgreSQL, un Redis ou un php-fpm
# déjà installés. Sans effet en production, où aucun port n'est publié.
DB_PORT=55432
REDIS_PORT=56379
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001

# --- Port de l'API sur le poste de développement ---
API_PORT=53000

# --- Authentification ---
# Doit être identique à celui de backend/.env. Générer avec `openssl rand -base64 32`.
AUTH_SECRET=remplacez-par-32-caracteres-aleatoires-minimum
AUTH_URL=http://localhost:8080

# --- Messagerie ---
# En développement, Mailpit capture tout : http://localhost:58025
# En production avec Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=votre.adresse@gmail.com et SMTP_PASSWORD = un mot de passe d'application
# (jamais le mot de passe du compte Google).
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Deco'Rek <contact@decorek.sn>"
MAIL_UI_PORT=58025
MAIL_SMTP_PORT=51025

# Adresse de MinIO joignable depuis le navigateur (URL de téléversement signées).
S3_PUBLIC_ENDPOINT=http://localhost:59000

# Port de l'API dédiée aux tests de bout en bout (base decorek_test)
API_E2E_PORT=53001
